{
  "name": "playwright-quality-engineering",
  "version": "1.0.0",
  "private": true,
  "description": "Senior-level Playwright + TypeScript quality engineering framework: UI, API contract, data integrity, accessibility and AI-assisted testing.",
  "author": "Stephen Adebanji",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --project=chromium --project=firefox --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --project=a11y",
    "test:unit": "playwright test --project=unit",
    "test:ai": "playwright test --project=ai",
    "test:flaky-hunt": "playwright test --project=chromium --repeat-each=5 --workers=6",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run format:check && npm run test:unit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
